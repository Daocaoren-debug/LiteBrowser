<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 播放器自带控制器：拖动进度、播放暂停；步长在代码里设为 10 秒 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!--
      手势层：盖在 PlayerView 上、在标题与旋屏按钮之下。
      控制器区域的触摸会穿透给 PlayerView 自己处理，其余区域由共用手势控制器接管。
    -->
    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部只留标题 -->
    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 旋屏按钮：右下角，透明底小图标，与资源嗅探播放器一致 -->
    <ImageButton
        android:id="@+id/rotateButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_player_icon"
        android:contentDescription="@string/player_rotate"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:tint="#FFFFFF" />

    <!-- 滑动 / 长按手势提示 -->
    <TextView
        android:id="@+id/seekHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
