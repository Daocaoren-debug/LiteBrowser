<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 下载到的公共 Download 目录，供 FileProvider 分享给播放器 -->
    <external-path name="external_downloads" path="Download/" />
    <!-- 应用私有目录（Android 10+ 下载落点） -->
    <external-files-path name="app_downloads" path="Download/" />
    <files-path name="internal_downloads" path="downloads/" />
</paths>
