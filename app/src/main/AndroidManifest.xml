<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网权限：浏览网页与播放网页视频必需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 用于判断网络可用性，无网络时给出提示，避免低端机上无谓加载 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DownloadManager 写入公共下载目录，Android 9 及以下需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 13+ 下载完成通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 本地 M3U8 扫描：Android 12 及以下读外部存储 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+ 所有文件访问，用于扫描 .m3u8 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 批量转换时以后台服务运行，避免切到后台就被杀掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- 播放时持有唤醒锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 允许从其他应用以 http/https 链接打开 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 内置播放器：网页嗅探视频用；configChanges 保证旋转不重建，sensor 跟随重力 -->
        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- 本地 M3U8 扫描列表：从浏览器"更多"菜单进入 -->
        <activity
            android:name=".m3u8.M3u8BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/m3u8_library" />

        <!-- 本地 M3U8 / MP4 播放器：旋屏完全手动（横竖两态），不写 screenOrientation 跟随重力 -->
        <activity
            android:name=".m3u8.M3u8PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- m3u8 -> mp4 无损封装转换；前台服务保证切后台后仍能跑完 -->
        <service
            android:name=".m3u8.ConvertService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
    </application>

</manifest>
